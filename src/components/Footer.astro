---
import { Image } from 'astro:assets';
import logoImg from '../assets/images/logo.png';
---

<footer class="footer">
  <div class="footer-map-container container">
    <h3 class="map-title">Notre Emplacement à Charleroi</h3>
    <div class="map-wrapper">
      <iframe 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2542.601671127465!2d4.435614676932887!3d50.41126067158474!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xa6a5da6876771913%3A0xad7eab9d8f32ba08!2sDeba%20D%C3%A9pannage%20Plombier%20Charleroi!5e0!3m2!1sen!2sbe!4v1784759016131!5m2!1sen!2sbe" 
        width="100%" 
        height="350" 
        style="border:0;" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="strict-origin-when-cross-origin"
        title="Carte Google Maps - Deba Dépannage Plombier Charleroi"
      ></iframe>
    </div>
  </div>

  <div class="container grid footer-grid">
    <div class="footer-col brand-col">
      <div class="logo bg-white p-2" style="background: white; padding: 10px; border-radius: 8px; display: inline-block;">
        <Image src={logoImg} alt="Logo Deba Dépannage Plombier Charleroi" width={250} height={80} style="height: 60px; width: auto; object-fit: contain;" />
      </div>
      <p class="mt-4">Votre expert local en plomberie, chauffage et débouchage à Charleroi. Intervention rapide et travail garanti par nos professionnels qualifiés.</p>
      <p class="mt-2 text-sm" style="font-size: 0.85rem; opacity: 0.8;">
        <strong>Dépannage Plombier Charleroi</strong>
      </p>
    </div>
    
    <div class="footer-col">
      <h3>Liens Rapides</h3>
      <ul>
        <li><a href="/">Accueil</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/locations">Zones</a></li>
        <li><a href="/tarifs">Tarifs</a></li>
        <li><a href="/about">À Propos</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/mentions-legales">Mentions Légales</a></li>
        <li><a href="/politique-confidentialite">Confidentialité</a></li>
      </ul>
    </div>
    
    <div class="footer-col">
      <h3>Services</h3>
      <ul>
        <li><a href="/services/depannage-urgence">Dépannage Urgence</a></li>
        <li><a href="/services/debouchage">Débouchage Canalisation</a></li>
        <li><a href="/services/chauffage-chaudieres">Entretien Chauffage</a></li>
        <li><a href="/services/detection-fuites">Recherche de Fuite</a></li>
      </ul>
    </div>
    
    <div class="footer-col">
      <h3>Contact</h3>
      <ul class="contact-list">
        <li>📍 <a href="https://maps.app.goo.gl/wLrCE3QZhcmmRTW98" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;">Av. des Alliés 42, 6000 Charleroi</a></li>
        <li>📞 0465 13 75 98</li>
        <li>✉️ contact@depannageplombiercharleroi.be</li>
        <li>🕒 24/7 Urgences</li>
      </ul>
    </div>
  </div>
  
  <div class="footer-bottom">
    <div class="container text-center">
      <p>&copy; {new Date().getFullYear()} Deba Dépannage Plombier Charleroi. Tous droits réservés.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--secondary);
    color: var(--text-light);
    padding-top: 80px;
  }
  
  .footer p {
    color: var(--text-light);
  }

  .footer-map-container {
    margin-bottom: 50px;
  }

  .map-title {
    margin-bottom: 15px;
    font-size: 1.3rem;
  }

  .map-wrapper {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }
  
  .footer-grid {
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 40px;
    margin-bottom: 60px;
  }
  
  .footer h3 {
    color: var(--text-light);
    margin-bottom: 20px;
    font-size: 1.2rem;
  }
  
  .footer ul li {
    margin-bottom: 12px;
  }
  
  .footer a {
    color: var(--accent);
  }
  
  .footer a:hover {
    color: var(--primary);
  }
  
  .text-light {
    color: var(--text-light);
  }
  
  .brand-name {
    font-size: 1.8rem;
    font-weight: 800;
  }
  
  .tagline {
    color: var(--primary);
    font-weight: 600;
  }
  
  .mt-4 {
    margin-top: 1rem;
  }
  
  .footer-bottom {
    background: #0a2548;
    padding: 20px 0;
    font-size: 0.9rem;
  }
  
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
