---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroImg from '../assets/images/hero.png';
import teamImg from '../assets/images/team.png';
import teamMarcImg from '../assets/images/team_marc.png';
import teamJulienImg from '../assets/images/team_julien.png';
import plumbingImg from '../assets/images/service_plumbing.png';
import unblockingImg from '../assets/images/service_unblocking.png';
import heatingImg from '../assets/images/service_heating.png';
---

<Layout 
  title="Plombier Charleroi 24h/24 | Urgence & Débouchage"
  description="Plombier à Charleroi pour fuite, dépannage, débouchage, sanitaire et chauffage. Intervention 24h/24. Appelez le 0465 13 75 98."
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg-shape"></div>
    <div class="container hero-container grid">
      <div class="hero-content">
        <span class="badge">Service 24/7 à Charleroi</span>
        <h1>Plombier à Charleroi disponible 24h/24</h1>
        <p class="mb-4" style="font-size: 1.25rem; font-weight: bold;">Intervention d'urgence sur tout le Grand Charleroi</p>
        <p>Expert local disponible 24h/24 pour tous vos besoins en plomberie, dépannage d'urgence, débouchage, sanitaire et chauffage.</p>
        <div class="hero-actions flex flex-wrap gap-4 items-center mt-8">
          <a href="tel:0465137598" class="btn btn-primary">Appelez le 0465 13 75 98</a>
          <a href="/contact" class="btn btn-secondary">Demander un Devis</a>
        </div>
      </div>
      <div class="hero-image">
        <div class="image-wrapper">
          <Image src={heroImg} alt="Plombier intervenant en urgence sur une fuite d\'eau à Charleroi" loading="eager" fetchpriority="high" widths={[400, 800, 1200]} sizes="(max-width: 768px) 100vw, 50vw" />
          <!-- Fake stats removed -->
        </div>

      </div>
      <div class="mt-12 text-center">
        <a href="/about" class="btn btn-secondary" style="background: transparent; border: 2px solid var(--primary); color: var(--primary);">Découvrez notre expertise et nos agréments</a>
      </div>
    </div>
  </section>


  <!-- Features Section -->
  <section class="section features">
    <div class="container">
      <div class="text-center mb-12">
        <span class="text-primary font-bold tracking-wider uppercase text-sm">Pourquoi nous choisir</span>
        <h2>Nos Services de Plomberie à Charleroi</h2>
      </div>
      <div class="grid feature-grid">
        <div class="card feature-card">
          <div class="icon-wrapper">🚀</div>
          <h3>Service Réactif</h3>
          <p>Intervention rapide pour toutes vos urgences sur la région de Charleroi.</p>
        </div>
        <div class="card feature-card">
          <div class="icon-wrapper">🚨</div>
          <h3>Plomberie d'Urgence</h3>
          <p>Une fuite au milieu de la nuit ? Notre équipe est disponible 24h/24 et 7j/7.</p>
        </div>
        <div class="card feature-card">
          <div class="icon-wrapper">💯</div>
          <h3>Équipe Qualifiée</h3>
          <p>Une équipe de plombiers et chauffagistes expérimentés pour un travail soigné.</p>
        </div>
        <div class="card feature-card">
          <div class="icon-wrapper">✅</div>
          <h3>Travail Garanti</h3>
          <p>Nous utilisons du matériel de pointe et offrons une garantie sur toutes nos réparations.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges (Brands & Certs) -->
  <section class="trust-brands bg-white" style="padding: 40px 0; border-bottom: 1px solid #eaeaea;">
    <div class="container text-center">
      <p class="text-muted text-sm font-bold uppercase tracking-wider mb-6">Nous Travaillons Avec Les Meilleures Marques</p>
      <div class="flex flex-wrap justify-center items-center gap-8 opacity-70" style="opacity: 0.6;">
        <span class="font-bold text-xl text-secondary" style="font-size: 1.5rem; margin: 0 15px;">CERGA</span>
        <span class="font-bold text-xl text-secondary" style="font-size: 1.5rem; margin: 0 15px;">Vaillant</span>
        <span class="font-bold text-xl text-secondary" style="font-size: 1.5rem; margin: 0 15px;">Bulex</span>
        <span class="font-bold text-xl text-secondary" style="font-size: 1.5rem; margin: 0 15px;">Viessmann</span>
        <span class="font-bold text-xl text-secondary" style="font-size: 1.5rem; margin: 0 15px;">Grohe</span>
        <span class="font-bold text-xl text-secondary" style="font-size: 1.5rem; margin: 0 15px;">Geberit</span>
      </div>
    </div>
  </section>

  <!-- Services Preview -->
  <section class="section services-preview bg-accent">
    <div class="container">
      <div class="flex justify-between items-center mb-12">
        <div>
          <span class="text-primary font-bold uppercase text-sm">Nos Services</span>
          <h2>Intervention d'Urgence et Dépannage</h2>
        </div>
        <a href="/services" class="btn btn-secondary">Voir tous les services</a>
      </div>
      <div class="grid service-grid">
        <div class="service-card">
          <Image src={plumbingImg} alt="Réparation de fuite d\'eau sous évier à Charleroi" loading="lazy" />
          <div class="service-content">
            <h3>Dépannage Plomberie</h3>
            <p>Réparation de fuites, remplacement de robinetterie et dépannage urgent.</p>
            <a href="/services/depannage-urgence" class="text-primary font-bold mt-4 inline-block">Dépannage plomberie d’urgence à Charleroi →</a>
          </div>
        </div>
        <div class="service-card">
          <Image src={unblockingImg} alt="Caméra d\'inspection de canalisation utilisée pour un débouchage" loading="lazy" />
          <div class="service-content">
            <h3>Débouchage Canalisation</h3>
            <p>Curage haute pression pour vos éviers, toilettes et égouts bouchés.</p>
            <a href="/services/debouchage" class="text-primary font-bold mt-4 inline-block">Débouchage de canalisation à Charleroi →</a>
          </div>
        </div>
        <div class="service-card">
          <Image src={heatingImg} alt="Chaudière gaz contrôlée par un technicien agréé à Charleroi" loading="lazy" />
          <div class="service-content">
            <h3>Entretien Chauffage</h3>
            <p>Entretien et réparation de chaudières toutes marques pour votre confort.</p>
            <a href="/services/chauffage-chaudieres" class="text-primary font-bold mt-4 inline-block">Chauffagiste à Charleroi →</a>
          </div>
        </div>
        <div class="service-card">
          <Image src={plumbingImg} alt="Détection de fuite non destructive par thermographie" loading="lazy" />
          <div class="service-content">
            <h3>Recherche de Fuite</h3>
            <p>Détection non destructive par thermographie et acoustique.</p>
            <a href="/services/detection-fuites" class="text-primary font-bold mt-4 inline-block">Recherche de fuite à Charleroi →</a>
          </div>
        </div>
        <div class="service-card">
          <Image src={unblockingImg} alt="Installation sanitaire" loading="lazy" />
          <div class="service-content">
            <h3>Installation Sanitaire</h3>
            <p>Installation de WC, pose de robinetterie et raccordements.</p>
            <a href="/services/installations-sanitaires" class="text-primary font-bold mt-4 inline-block">Installation sanitaire à Charleroi →</a>
          </div>
        </div>
        <div class="service-card">
          <Image src={heatingImg} alt="Rénovation de salle de bain à Charleroi" loading="lazy" />
          <div class="service-content">
            <h3>Rénovation de Salle de Bain</h3>
            <p>Rénovation de salle de bain, douche et baignoire.</p>
            <a href="/services/renovation-salle-de-bain" class="text-primary font-bold mt-4 inline-block">Rénovation de salle de bain à Charleroi →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team / About Preview -->
  <section class="section team">
    <div class="container text-center">
      <span class="text-primary font-bold uppercase text-sm">Notre Équipe</span>
      <h2 class="mb-12">Réparation et Précision</h2>
      <div class="grid team-grid">
        <div class="team-member">
          <div class="team-img-wrapper">
            <Image src={teamImg} alt="" loading="lazy" />
          </div>
          <h4 class="mt-4">Thomas D.</h4>
          <p>Plombier Expert</p>
        </div>
        <div class="team-member">
          <div class="team-img-wrapper">
            <Image src={teamMarcImg} alt="" loading="lazy" />
          </div>
          <h4 class="mt-4">Marc L.</h4>
          <p>Chauffagiste Agréé</p>
        </div>
        <div class="team-member">
          <div class="team-img-wrapper">
            <Image src={teamJulienImg} alt="" loading="lazy" />
          </div>
          <h4 class="mt-4">Julien S.</h4>
          <p>Spécialiste Débouchage</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Highlights (Replaced fake stats) -->
  <section class="section stats bg-primary text-light">
    <div class="container grid stats-grid text-center">
      <div>
        <div class="text-white text-3xl" style="font-weight: bold;">24h/24 7j/7</div>
        <p class="text-accent mt-2">Disponibilité</p>
      </div>
      <div>
        <div class="text-white text-3xl" style="font-weight: bold;">Devis Clair</div>
        <p class="text-accent mt-2">Prix Transparents</p>
      </div>
      <div>
        <div class="text-white text-3xl" style="font-weight: bold;">Grand Charleroi</div>
        <p class="text-accent mt-2">Intervention Rapide</p>
      </div>
      <div>
        <div class="text-white text-3xl" style="font-weight: bold;">Pro</div>
        <p class="text-accent mt-2">Équipe Qualifiée</p>
      </div>
    </div>
  </section>

  <!-- Testimonials Placeholder (Removed fake testimonials) -->
  <section class="section testimonials bg-light">
    <div class="container text-center">
      <span class="text-primary font-bold uppercase text-sm">Avis</span>
      <h2>Découvrez ce que nos clients disent de nous</h2>
      <div class="mt-8">
        <a href="https://g.page/r/YOUR_GOOGLE_LINK/review" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Voir nos avis Google</a>
      </div>
    </div>
  </section>

  <!-- FAQ Section (Answer Engine Optimized) -->
  <section class="section faq bg-white" style="border-top: 1px solid #eaeaea;">
    <div class="container">
      <div class="text-center mb-12">
        <span class="text-primary font-bold uppercase text-sm">Questions Fréquentes</span>
        <h2>Tout Savoir Sur Nos Interventions</h2>
      </div>
      <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
        <div class="card p-6" style="padding: 2rem;">
          <h3 class="text-xl font-bold mb-3" style="font-size: 1.25rem;">Quel est le délai d'intervention pour une urgence plomberie à Charleroi ?</h3>
          <p>Nous intervenons très rapidement, 24h/24 et 7j/7 dans tout le Grand Charleroi. Notre équipe mobile est toujours prête à se déplacer pour limiter les dégâts d'eau au plus vite.</p>
        </div>
        <div class="card p-6" style="padding: 2rem;">
          <h3 class="text-xl font-bold mb-3" style="font-size: 1.25rem;">Quels sont les tarifs d'un plombier en urgence ?</h3>
          <p>Nos tarifs sont 100% transparents et annoncés avant le début de toute intervention. Le prix varie selon la nature du dépannage, mais nous garantissons une tarification honnête, sans frais cachés, même la nuit et le week-end.</p>
        </div>
        <div class="card p-6" style="padding: 2rem;">
          <h3 class="text-xl font-bold mb-3" style="font-size: 1.25rem;">Faites-vous le débouchage de canalisations et d'égouts ?</h3>
          <p>Absolument. Nous sommes équipés de matériel de curage haute pression et de caméras d'inspection pour résoudre définitivement les problèmes d'égouts, toilettes, éviers ou baignoires bouchés.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area Map -->
  <section class="section map-section">
    <div class="container">
      <div class="text-center mb-12">
        <span class="text-primary font-bold uppercase text-sm">Proximité & Intervention</span>
        <h2>Plombier Actif sur le Grand Charleroi</h2>
        <p class="text-muted mt-4 max-w-2xl mx-auto" style="max-width: 800px; margin: 1rem auto 0;">Nous intervenons rapidement sur tout le Grand Charleroi et sa périphérie. Grâce à notre position stratégique, nos techniciens sont sur place dans les meilleurs délais lors d'une urgence.</p>
      </div>
      <div class="map-container" style="border-radius: var(--border-radius); overflow: hidden; height: 400px; box-shadow: var(--box-shadow); border: 2px solid var(--accent);">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d81248.51468603504!2d4.364379361664156!3d50.42858167886477!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c225e3612f00f5%3A0x40099ab2f4d5460!2sCharleroi!5e0!3m2!1sfr!2sbe!4v1700000000000!5m2!1sfr!2sbe" 
          width="100%" 
          height="100%" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </section>

  <!-- Zones & Guides -->
  <section class="section bg-light" style="background: #f8f9fa;">
    <div class="container grid" style="grid-template-columns: 1fr 1fr; gap: 40px; align-items: start;">
      <div class="card p-6" style="background: white; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
        <h3 class="text-secondary mb-4">📍 Nos Zones d'Intervention</h3>
        <p class="text-muted mb-4">Nous intervenons rapidement à Charleroi et dans toutes les communes environnantes du Hainaut pour vos urgences plomberie et chauffage.</p>
        <a href="/locations" class="text-primary font-bold">Voir toutes nos zones d'intervention →</a>
      </div>
      
      <div class="card p-6" style="background: white; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
        <h3 class="text-secondary mb-4">📚 Guides Pratiques</h3>
        <ul class="text-muted" style="list-style-type: none; padding-left: 0;">
          <li class="mb-2">🔹 <a href="/blog/panne-chauffe-eau-urgence-charleroi" style="color: var(--primary); text-decoration: underline;">Que faire lors d'une panne de chauffe-eau ?</a></li>
          <li class="mb-2">🔹 <a href="/blog/debouchage-urgent-charleroi" style="color: var(--primary); text-decoration: underline;">Comment réaliser un débouchage urgent ?</a></li>
          <li class="mb-2">🔹 <a href="/blog/entretien-chaudiere-gaz-charleroi-loi" style="color: var(--primary); text-decoration: underline;">L'entretien de la chaudière gaz en Wallonie</a></li>
        </ul>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero {
    position: relative;
    padding: 80px 0 120px;
    overflow: hidden;
  }
  
  .hero-bg-shape {
    position: absolute;
    top: 0;
    right: 0;
    width: 45%;
    height: 100%;
    background: var(--secondary);
    border-top-left-radius: 300px;
    border-bottom-left-radius: 300px;
    z-index: 0;
  }
  
  .hero-container {
    grid-template-columns: 1.2fr 0.8fr;
    gap: 40px;
    align-items: center;
    position: relative;
    z-index: 10;
  }
  
  .hero-content {
    position: relative;
    z-index: 10;
  }
  
  .hero-image {
    position: relative;
    z-index: 10;
  }
  
  .mt-8 { margin-top: 2rem; }
  .mb-12 { margin-bottom: 3rem; }
  .mb-4 { margin-bottom: 1rem; }
  .mb-6 { margin-bottom: 1.5rem; }
  
  .image-wrapper {
    position: relative;
    border-radius: 50%;
    padding: 20px;
    background: white;
    box-shadow: var(--box-shadow);
  }
  
  .image-wrapper img {
    border-radius: 50%;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  
  .stats-float {
    position: absolute;
    bottom: 20px;
    left: -30px;
    padding: 15px 25px;
    border-radius: 20px;
    z-index: 2;
  }
  
  .feature-grid {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
  }
  
  .icon-wrapper {
    width: 60px;
    height: 60px;
    background: var(--accent);
    color: var(--primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    margin-bottom: 20px;
  }
  
  .bg-accent { background: var(--accent); }
  .bg-primary { background: var(--primary); }
  .text-white { color: white; }
  .text-accent { color: var(--accent); }
  .text-5xl { font-size: 3rem; }
  
  .service-grid {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }
  
  .service-card {
    background: white;
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: var(--box-shadow);
    transition: var(--transition);
  }
  
  .service-card:hover {
    transform: translateY(-10px);
  }
  
  .service-card img {
    width: 100%;
    height: 250px;
    object-fit: cover;
  }
  
  .service-content {
    padding: 30px;
  }
  
  .team-grid {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 40px;
    justify-content: center;
  }
  
  .team-img-wrapper {
    width: 200px;
    height: 200px;
    margin: 0 auto;
    border-radius: 50%;
    overflow: hidden;
    border: 5px solid var(--accent);
  }
  
  .team-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .stats-grid {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 30px;
  }
  
  .testimonial-grid {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }
  
  @media (max-width: 992px) {
    .hero-container {
      grid-template-columns: 1fr;
    }
    .hero-bg-shape {
      width: 100%;
      height: 50%;
      top: auto;
      bottom: 0;
      border-bottom-left-radius: 0;
      border-top-right-radius: 100px;
    }
  }
</style>
